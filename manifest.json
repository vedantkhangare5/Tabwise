{
  "manifest_version": 3,
  "name": "TabWise",
  "version": "1.0.0",
  "description": "A premium bookmark manager that replaces your new tab page.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "activeTab",
    "tabs"
  ],
  "commands": {
    "quick-save": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Quick save the current tab as a bookmark"
    }
  },
  "action": {
    "default_title": "TabWise",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
